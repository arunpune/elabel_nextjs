{
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wine-label-management-system.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://wine-label-management-system.onrender.com/uploads/:path*"
    },
    {
      "source": "/dpp/:path*",
      "destination": "https://wine-label-management-system.onrender.com/dpp/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
